#!/command/with-contenv /usr/bin/bash
# shellcheck shell=bash

# Thin wrapper that invokes the real bootstrap. We keep the heavy
# logic in /usr/local/bin/openhost-bootstrap.sh so it can be tested
# (or run by hand for debugging) without going through s6's
# `with-contenv` shim.
exec /usr/local/bin/openhost-bootstrap.sh
